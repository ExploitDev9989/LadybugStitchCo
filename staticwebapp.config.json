{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/shop", "rewrite": "/shop.html" },
    { "route": "/api/*", "headers": { "Cache-Control": "no-store" } }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
